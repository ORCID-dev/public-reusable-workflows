{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "customManagers:githubActionsVersions",
    ":enablePreCommit"
  ],
  "enabledManagers": ["github-actions", "custom.regex", "pre-commit"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "BuildKit image pinned by tag and digest",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "BUILDKIT_IMAGE: (?<depName>moby/buildkit):(?<currentValue>v[0-9.]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Transifex CLI pinned by version and sha256",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "TX_VERSION: (?<currentValue>v[0-9.]+)\\s+TX_SHA256: (?<currentDigest>[a-f0-9]{64})"
      ],
      "depNameTemplate": "transifex/cli",
      "datasourceTemplate": "github-release-attachments"
    }
  ],
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "5 days",
  "prConcurrentLimit": 3,
  "vulnerabilityAlerts": {
    "schedule": ["at any time"],
    "commitMessagePrefix": "fix(security):"
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "ci tooling",
      "commitMessagePrefix": "chore(deps):"
    },
    {
      "matchUpdateTypes": ["major"],
      "commitMessagePrefix": "chore(deps):",
      "dependencyDashboardApproval": true
    },
    {
      "description": "A new Python minor waits for approval, until Semgrep supports it",
      "matchDepNames": ["python"],
      "matchUpdateTypes": ["minor"],
      "groupName": "python",
      "dependencyDashboardApproval": true
    },
    {
      "matchPackageNames": [
        "ORCID-dev/public-reusable-workflows",
        "ORCID/public-reusable-workflows"
      ],
      "enabled": false
    }
  ]
}
